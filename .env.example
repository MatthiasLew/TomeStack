# ==========================================
# TomeStack Environment Configuration
# ==========================================

# 1. Polish National Library API (Otwarte API Biblioteki Narodowej)
# Całkowicie darmowe i otwarte API. Nie wymaga klucza.
DATA_BN_API_URL=https://data.bn.org.pl/api

# 2. Google Books API (Opcjonalnie - dla okładek i wydań zagranicznych)
# Klucz z Google Cloud Console (opcjonalny, bez klucza działa z niższym limitem)
# GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# 3. Open Library API (Opcjonalnie - światowe wydania)
OPEN_LIBRARY_API_URL=https://openlibrary.org

# 4. Supabase (Baza danych PostgreSQL i Auth - Krok 7)
# Pobierz z ustawień projektu Supabase: https://supabase.com/dashboard/project/.../settings/api
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 5. Integrator Cen (Ceneo / Allegro - opcjonalnie w przyszłości)
# ALLEGRO_CLIENT_ID=your_allegro_client_id
# ALLEGRO_CLIENT_SECRET=your_allegro_client_secret